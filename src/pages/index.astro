---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AIAssistant from '../components/AIAssistant.vue';

// 1. Fetch data from content collections
const rawExperience = await getCollection('experience');
const rawProjects = await getCollection('projects');

// Helper to convert date strings like "Mar 2024" or "2024-03" into numbers for sorting
const parseDate = (dateStr?: string) => {
  if (!dateStr) return 0;
  const timestamp = Date.parse(dateStr);
  if (!isNaN(timestamp)) return timestamp;
  
  // Fallback for "Month Year" formats (e.g. "Mar 2024")
  const parts = dateStr.trim().split(' ');
  if (parts.length === 2) {
    const year = parseInt(parts[1], 10);
    return isNaN(year) ? 0 : year;
  }
  return 0;
};

// 2. Sort experience chronologically (Current first, then newest date)
const sortedExperience = rawExperience.sort((a, b) => {
  const aCurrent = a.data.current ?? (a.data.period?.includes('Current') || a.data.period?.includes('Present')) ?? false;
  const bCurrent = b.data.current ?? (b.data.period?.includes('Current') || b.data.period?.includes('Present')) ?? false;

  if (aCurrent !== bCurrent) return aCurrent ? -1 : 1;

  const aTime = parseDate(a.data.startDate ?? a.data.period);
  const bTime = parseDate(b.data.startDate ?? b.data.period);

  return bTime - aTime; // Newest dates first
});

// 3. Sort projects by explicit numeric order (1, 2, 3...)
const sortedProjects = rawProjects.sort((a, b) => {
  const aOrder = a.data.order !== undefined ? Number(a.data.order) : 99;
  const bOrder = b.data.order !== undefined ? Number(b.data.order) : 99;

  if (aOrder !== bOrder) return aOrder - bOrder;

  const aTitle = a.data.title ?? '';
  const bTitle = b.data.title ?? '';
  return aTitle.localeCompare(bTitle);
});

// Pre-render content
const processedExperience = await Promise.all(
  sortedExperience.map(async (exp) => {
    const { Content } = await render(exp);
    return { ...exp, Content };
  })
);

const processedProjects = await Promise.all(
  sortedProjects.map(async (project) => {
    const { Content } = await render(project);
    return { ...project, Content };
  })
);
---

<Layout title="William Power | Solution Architect">
  <main class="max-w-5xl mx-auto px-4 py-12 space-y-16">

    <!-- Nav -->
    <nav class="flex justify-end">
      <a href="/writing" class="text-sm font-mono text-slate-400 hover:text-slate-200 transition-colors">
        Writing &rarr;
      </a>
    </nav>

    <!-- Hero / AI Assistant Section -->
    <section class="space-y-6">
      <div class="text-center space-y-3">
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
          William Power
        </h1>
        <p class="text-lg text-slate-400 max-w-2xl mx-auto">
          Solution Architect specializing in Cloud Platforms, Enterprise RAG Integration, and Event-Driven Systems.
        </p>
      </div>

      <!-- Interactive AI RAG Widget -->
      <AIAssistant client:load />
    </section>

    <!-- Featured Projects Section -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-slate-100 border-b border-slate-800 pb-3">
        Projects
      </h2>
      <div class="grid gap-6 md:grid-cols-2">
        {processedProjects.map((project) => (
          <div id={project.id} class="bg-slate-900 border border-slate-800 rounded-xl p-6 flex flex-col justify-between hover:border-slate-700 transition-colors scroll-mt-24">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-semibold text-white">{project.data.title}</h3>
                {project.data.category && (
                  <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-indigo-950 text-indigo-400 border border-indigo-800">
                    {project.data.category}
                  </span>
                )}
              </div>
              {project.data.subtitle && (
                <p class="text-sm font-medium text-slate-400">{project.data.subtitle}</p>
              )}
              <div class="text-sm text-slate-300 prose prose-invert max-w-none">
                <project.Content />
              </div>
              {project.data.repoUrl && (
                <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-mono text-indigo-400 hover:text-indigo-300 transition-colors">
                  View source &rarr;
                </a>
              )}
            </div>

            {project.data.tech && (
              <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-slate-800/60">
                {project.data.tech.map((t: string) => (
                  <span class="text-xs font-mono bg-slate-950 text-slate-400 px-2 py-1 rounded border border-slate-800">
                    {t}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Experience Section -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-slate-100 border-b border-slate-800 pb-3">
        Experience
      </h2>
      <div class="space-y-8">
        {processedExperience.map((exp) => (
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
              <div>
                <h3 class="text-lg font-bold text-white">{exp.data.role}</h3>
                <p class="text-sm text-indigo-400 font-medium">{exp.data.company}</p>
              </div>
              <span class="text-xs font-mono text-slate-400 bg-slate-950 px-3 py-1 rounded-full border border-slate-800 w-max">
                {exp.data.period}
              </span>
            </div>
            <div class="text-sm text-slate-300 prose prose-invert max-w-none">
              <exp.Content />
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
</Layout>