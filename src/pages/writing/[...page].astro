---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostBanner from '../../components/PostBanner.astro';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection('writing', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;
---

<Layout
  title={page.currentPage === 1 ? 'Writing | William Power' : `Writing — Page ${page.currentPage} | William Power`}
  description="Long-form writing on architecture, AI governance, and shipped project work."
>
  <main class="max-w-3xl mx-auto px-4 py-12 sm:py-16 space-y-12">
    <div class="space-y-3">
      <a href="/" class="text-sm text-slate-400 hover:text-slate-200 transition-colors">&larr; Back home</a>
      <h1 class="font-sans text-4xl font-bold tracking-tight text-white">Writing</h1>
      <p class="font-serif text-lg text-slate-400 leading-relaxed">Long-form notes on architecture, AI governance, and shipped project work.</p>
    </div>

    <div class="space-y-8">
      {page.data.map((post) => (
        <a
          href={`/writing/${post.id}`}
          class="group block bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 hover:shadow-lg hover:shadow-slate-950/50 transition-all"
        >
          <PostBanner seed={post.id} title={post.data.title} image={post.data.image} imageAlt={post.data.imageAlt} compact />
          <div class="p-6 sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <h2 class="font-sans text-xl sm:text-2xl font-semibold text-white group-hover:text-indigo-300 transition-colors">
                {post.data.title}
              </h2>
              {post.data.readingTime && (
                <span class="text-xs font-mono px-2 py-1 rounded-md bg-slate-800 text-slate-400 whitespace-nowrap shrink-0">{post.data.readingTime}</span>
              )}
            </div>
            <p class="font-serif text-slate-400 leading-relaxed mt-3">{post.data.description}</p>
            <div class="flex flex-wrap items-center justify-between gap-3 mt-5 pt-5 border-t border-slate-800/70">
              <time class="text-xs font-mono text-slate-500" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag: string) => (
                  <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-indigo-950 text-indigo-400 border border-indigo-800">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
      {page.data.length === 0 && (
        <p class="text-slate-500 text-sm">No posts published yet.</p>
      )}
    </div>

    {page.lastPage > 1 && (
      <nav class="flex items-center justify-between pt-4 border-t border-slate-800" aria-label="Pagination">
        {page.url.prev ? (
          <a href={page.url.prev} class="text-sm font-mono text-slate-400 hover:text-white transition-colors">&larr; Newer</a>
        ) : <span></span>}
        <span class="text-xs font-mono text-slate-600">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="text-sm font-mono text-slate-400 hover:text-white transition-colors">Older &rarr;</a>
        ) : <span></span>}
      </nav>
    )}
  </main>
</Layout>
