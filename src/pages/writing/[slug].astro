---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostBanner from '../../components/PostBanner.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const relatedProject = post.data.relatedProject
  ? await getEntry('projects', post.data.relatedProject)
  : undefined;
---

<Layout title={`${post.data.title} | William Power`} description={post.data.description}>
  <PostBanner seed={post.id} title={post.data.title} image={post.data.image} imageAlt={post.data.imageAlt} />

  <main class="max-w-3xl mx-auto px-4 py-10 sm:py-14 space-y-10">
    <a href="/writing" class="text-sm text-slate-400 hover:text-slate-200 transition-colors">&larr; All writing</a>

    <article class="space-y-8">
      <header class="space-y-4">
        <h1 class="font-sans text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">{post.data.title}</h1>
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-500">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {post.data.readingTime && <span>&middot; {post.data.readingTime}</span>}
        </div>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-indigo-950 text-indigo-400 border border-indigo-800">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <div class="prose-article prose prose-invert prose-lg max-w-none
        prose-headings:font-sans prose-headings:font-semibold prose-headings:tracking-tight
        prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:leading-relaxed prose-p:text-slate-300
        prose-li:text-slate-300 prose-li:leading-relaxed
        prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:underline
        prose-strong:text-white prose-strong:font-semibold
        prose-blockquote:border-indigo-700 prose-blockquote:text-slate-400 prose-blockquote:not-italic
        prose-code:font-mono prose-code:text-indigo-300 prose-code:before:content-none prose-code:after:content-none
        prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800
        prose-table:text-sm prose-th:text-slate-300 prose-td:text-slate-400 prose-hr:border-slate-800">
        <Content />
      </div>

      {relatedProject && (
        <div class="mt-10 pt-6 border-t border-slate-800">
          <p class="text-xs font-mono text-slate-500 uppercase tracking-wide mb-2">Related project</p>
          <a href={`/#${relatedProject.id}`} class="block bg-slate-900 border border-slate-800 rounded-xl p-4 hover:border-slate-700 transition-colors">
            <p class="text-white font-semibold">{relatedProject.data.title}</p>
            <p class="text-sm text-slate-400 mt-1">{relatedProject.data.summary}</p>
          </a>
        </div>
      )}
    </article>
  </main>
</Layout>
