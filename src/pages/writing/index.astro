---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('writing', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Writing | William Power"
  description="Long-form writing on architecture, AI governance, and shipped project work."
>
  <main class="max-w-3xl mx-auto px-4 py-12 space-y-10">
    <div class="space-y-3">
      <a href="/" class="text-sm text-slate-400 hover:text-slate-200 transition-colors">&larr; Back home</a>
      <h1 class="text-3xl font-bold tracking-tight text-white">Writing</h1>
      <p class="text-slate-400">Long-form notes on architecture, AI governance, and shipped project work.</p>
    </div>

    <div class="space-y-6">
      {posts.map((post) => (
        <a
          href={`/writing/${post.id}`}
          class="block bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition-colors"
        >
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-xl font-semibold text-white">{post.data.title}</h2>
            {post.data.readingTime && (
              <span class="text-xs font-mono text-slate-500 whitespace-nowrap">{post.data.readingTime}</span>
            )}
          </div>
          <p class="text-sm text-slate-400 mt-2">{post.data.description}</p>
          <div class="flex items-center justify-between mt-4">
            <time class="text-xs font-mono text-slate-500" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <div class="flex gap-2">
              {post.data.tags.map((tag: string) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-indigo-950 text-indigo-400 border border-indigo-800">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
      {posts.length === 0 && (
        <p class="text-slate-500 text-sm">No posts published yet.</p>
      )}
    </div>
  </main>
</Layout>
